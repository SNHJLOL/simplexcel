{
  "name": "simplexcel",
  "version": "1.0.0",
  "description": "Simplexcel - Simple 广场表格工具（本地代理 + Excel 风格界面）",
  "private": true,
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/ui.test.js && node test/server.test.js",
    "test:ui": "node test/ui.test.js",
    "test:server": "node test/server.test.js",
    "build:exe": "pkg package.json --targets node18-win-x64 --output dist/Simplexcel.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "pkg": "^5.8.1"
  }
}